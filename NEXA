// src/index.js

class NEXA {
  constructor(options = {}) {
    this.options = {
      debug: false,
      ...options
    };

    this.modules = new Map();
  }

  register(name, module) {
    if (!name || !module) {
      throw new Error("A valid module name and module are required.");
    }

    if (this.modules.has(name)) {
      throw new Error(`Module "${name}" is already registered.`);
    }

    this.modules.set(name, module);

    if (this.options.debug) {
      console.log(`[NEXA] Module registered: ${name}`);
    }

    return this;
  }

  use(name) {
    const module = this.modules.get(name);

    if (!module) {
      throw new Error(`Module "${name}" was not found.`);
    }

    return module;
  }

  has(name) {
    return this.modules.has(name);
  }

  list() {
    return [...this.modules.keys()];
  }

  remove(name) {
    return this.modules.delete(name);
  }

  clear() {
    this.modules.clear();
  }
}

export default NEXA;


// Example

import NEXA from "./src/index.js";

const app = new NEXA({
  debug: true
});

app.register("logger", {
  info(message) {
    console.log(`[INFO] ${message}`);
  }
});

const logger = app.use("logger");

logger.info("NEXA is running.");


// README.md

# NEXA

A minimal, fast, and extensible developer toolkit.

NEXA is built around a simple idea: keep the core small,
make modules easy to add, and avoid unnecessary complexity.

## Installation

```bash
git clone https://github.com/yourusername/nexa.git
cd nexa
npm install
import NEXA from "./src/index.js";

const app = new NEXA();

app.register("logger", {
  info(message) {
    console.log(message);
  }
});

app.use("logger").info("Hello from NEXA.");
